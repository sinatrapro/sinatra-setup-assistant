{
  "name": "Sinatra Setup Assistant",
  "description": "Automates Sinatra setup on VTEX: creates client profiles, generates API keys, and syncs them across linked white-label sellers.",
  "version": "0.0.1",
  "manifest_version": 3,
  "default_locale": "en",

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "permissions": ["cookies", "activeTab"],

  "host_permissions": [
    "https://*.vtexcommercestable.com.br/*",
    "https://*.myvtex.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  }
}
